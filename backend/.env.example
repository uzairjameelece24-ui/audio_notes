# Database URL (Postgres)
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/audio_notes

# Storage (S3-compatible: S3Mock / MinIO in dev, Cloudflare R2 / Supabase Storage in prod)
S3_ENDPOINT_URL=http://localhost:9090
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET_NAME=audio-notes
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Gnani ASR Configuration
GNANI_API_KEY=
GNANI_API_URL=https://api.vachana.ai/stt/v3
ASR_MODE=mock

# LLM (Gemini) Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MODE=mock

# Failure Injection (comma-separated: asr_500, asr_timeout, asr_403, bad_summary, corrupt_audio)
FAIL_INJECT=

# Worker & Upload Tuning
WORKER_CONCURRENCY=3
MAX_UPLOAD_MB=500
MAX_DURATION_MIN=120
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
